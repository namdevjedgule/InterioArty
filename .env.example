# Required: Groq API key (console.groq.com). Without it the chat API degrades
# to a polite offline message instead of erroring.
GROQ_API_KEY=

# Optional: override the Groq model. Defaults to openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b

# Admin panel (/admin.html). Choose a long password. Required to sign in.
ADMIN_PASSWORD=
# Optional: key used to sign admin session cookies. Defaults to a value derived
# from ADMIN_PASSWORD (changing the password then signs everyone out).
# ADMIN_SESSION_SECRET=

# Lead storage for production: Upstash Redis (Vercel Marketplace sets these).
# Without them, leads are stored in .data/leads.json for local development only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
